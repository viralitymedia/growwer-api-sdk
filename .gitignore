# Derived from sdks.json on every run; committing it would let it disagree with the manifest.
.generator-configs/

# Per-language build output and local toolchain state. None of it is generated by ./generate.sh,
# so none of it belongs in the repository.
.venv/
__pycache__/
*.egg-info/
node_modules/
typescript/dist/
/vendor/
/composer.lock
php/vendor/
java/target/
csharp/**/bin/
csharp/**/obj/
ruby/Gemfile.lock
ruby/*.gem

# Compiled fixture tests and their build output.
tests/typescript/*.js
tests/csharp/bin/
tests/csharp/obj/
