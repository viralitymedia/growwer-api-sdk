{
    "name": "growwer/growwer-api-sdk",
    "description": "Official PHP client for the Growwer API: orders, projects, the media catalogue, seller medias and wallets.",
    "keywords": [
        "growwer",
        "api",
        "sdk",
        "seo",
        "link-building",
        "sponsored-posts",
        "marketplace"
    ],
    "homepage": "https://github.com/viralitymedia/growwer-api-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Growwer Support",
            "email": "support@growwer.com",
            "homepage": "https://growwer.com/contact/"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "Growwer\\Api\\": "php/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Growwer\\Api\\Test\\": "php/test/"
        }
    },
    "support": {
        "issues": "https://github.com/viralitymedia/growwer-api-sdk/issues",
        "docs": "https://tool.growwer.com/api/v1/doc"
    }
}
