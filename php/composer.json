{
    "name": "growwer/growwer-api-sdk",
    "description": "Official client for the Growwer API: orders, projects, the media catalogue, seller medias and wallets.",
    "keywords": [
        "growwer",
        "api",
        "sdk",
        "seo",
        "link-building"
    ],
    "homepage": "https://github.com/viralitymedia/growwer-api-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Virality Media, S.L.",
            "homepage": "https://growwer.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "Growwer\\Api\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Growwer\\Api\\Test\\": "test/"
        }
    }
}
